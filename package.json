{
  "name": "lignee-jardin",
  "private": true,
  "version": "1.0.0",
  "description": "Lignée Jardin — carnet de bord hors-ligne du potager : plantes et planches, journal photo, besoins NPK par stade, bilan hydrique, plan du jardin, tâches du jour",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "pc": "npm run build && tsx server/jardin-pc.ts",
    "pc:start": "tsx server/jardin-pc.ts",
    "android:sync": "npm run build && npx cap sync android",
    "android:open": "npx cap open android",
    "android:assets": "npx capacitor-assets generate --android --iconBackgroundColor '#152218' --iconBackgroundColorDark '#152218' --assetPath assets && node scripts/android-icon-extras.mjs",
    "test": "tsx tests/jardin-engine.test.ts",
    "test:ateliers": "node tests/ateliers/run.mjs"
  },
  "dependencies": {
    "@capacitor/filesystem": "^8.1.3",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/share": "^8.0.2",
    "jspdf": "^4.2.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "@capacitor/splash-screen": "^8.0.2",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "^1.3.0"
  }
}
